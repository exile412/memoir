# ===== memoir 环境配置示例 =====
# 复制成 .env 里的变量导出即可用；环境变量优先级最高。
# 也可以直接改 MEMOIR_HOME/config.json（memoir config --edit）。

# 数据根目录（数据库、插件、日志都放这；默认 ~/.memoir）
# MEMOIR_HOME=/home/you/.memoir

# 界面语言：zh | en | ja | ko
MEMOIR_LANG=zh

# ----- 模型接入（任何 OpenAI 兼容接口都能用）-----
# 本地 Ollama:
# MEMOIR_BASE_URL=http://127.0.0.1:11434/v1
# MEMOIR_MODEL=qwen2.5:7b
# MEMOIR_API_KEY=

# 本地 vLLM / LM Studio:
# MEMOIR_BASE_URL=http://127.0.0.1:1234/v1
# MEMOIR_MODEL=deepseek-r1-distill-qwen-7b

# 线上（自备 key，你的机器直连，不经过任何中转）:
# MEMOIR_BASE_URL=https://api.deepseek.com/v1
# MEMOIR_MODEL=deepseek-chat
# MEMOIR_API_KEY=sk-xxxxx

MEMOIR_TEMPERATURE=0.7
MEMOIR_MAX_TOKENS=2048
MEMOIR_TIMEOUT=120

# ----- 每晚复盘 -----
# 每天复盘时间（24 小时制，本地时区）
MEMOIR_REVIEW_AT=23:30
